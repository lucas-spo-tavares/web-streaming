# Copie para .env.deploy na RAIZ. Os comandos npm deploy, deploy:back e deploy:front carregam este arquivo automaticamente.
# Guia completo: docs/environment.md. Substitua os placeholders.
# Não manter inputs divergentes em infra/terraform.tfvars e TF_VAR_*.

# Região da aplicação: obrigatória no fluxo de deploy. Deve coincidir com TF_VAR_region.
AWS_REGION=sa-east-1
# Opcional: perfil/SSO. Em CI, use a role/cadeia de credenciais externa, sem este campo.
AWS_PROFILE=lucas-personal
# Não preencher chaves estáticas aqui. AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_SESSION_TOKEN, AWS_ROLE_ARN e AWS_WEB_IDENTITY_TOKEN_FILE são externos ao exemplo.

# Inputs obrigatórios Terraform. Nome deve ser único; caminho é da chave PÚBLICA RSA 2048.
TF_VAR_name=PREENCHA-nome-unico
# Caminhos Terraform são relativos a infra/; prefira caminho absoluto.
TF_VAR_signing_public_key_path=/PREENCHA/caminho/seguro/public.pem
# Inputs opcionais com seus padrões atuais.
TF_VAR_region=sa-east-1
TF_VAR_environment=production
TF_VAR_local_front_origin=http://localhost:5173
TF_VAR_max_upload_bytes=21474836480
# Zona pública existente e domínio do front. Certificado dedicado criado pelo Terraform.
TF_VAR_hosted_zone_name=lucas-tavares.com
TF_VAR_frontend_domain_name=streaming.lucas-tavares.com


# Condicional, etapa owner: email administrativo, fora do Terraform.
ACERVO_OWNER_EMAIL=PREENCHA_EMAIL
# Condicional, etapa secrets: caminho PRIVADO local, nunca o conteúdo PEM.
ACERVO_SIGNING_PRIVATE_KEY_PATH=/PREENCHA/caminho/seguro/private.pem

# Após provisionar: pool, buckets, distribuição e ARNs vêm dos outputs Terraform.
# As quatro VITE_* são geradas em front/.env.local; não são inputs do primeiro deploy.
