# Copie para back/.env.local para validar ou gerar um bundle local fora da AWS.
# Vite carrega este arquivo em modos diferentes de production; não inicia servidor local.
# Build: npm run build -w back -- --mode development. Produção lê as envs do runtime.
# Na AWS os valores abaixo são injetados pelo Terraform; AWS_REGION vem do runtime.
# Valores são referências/configuração; NUNCA incluir conteúdo de segredos.

# Obrigatórias em todas as operações; sem padrão. OPERATION: list/start/parts/complete/abort/stream/short/delete/renew/download/cleanup.
OPERATION=list
MEDIA_BUCKET=PREENCHA-media
RETENTION_TABLE=PREENCHA-retention
AWS_REGION=sa-east-1

# Obrigatória para list/start/parts/complete/abort; fonte: output ticket_parameter_arn.
TICKET_PARAMETER_ARN=arn:aws:ssm:sa-east-1:000000000000:parameter/PREENCHA-ticket

# Obrigatórias para stream e short; fontes: media_domain e recursos/outputs Terraform.
MEDIA_DOMAIN=PREENCHA.cloudfront.net
SIGNING_PARAMETER_ARN=arn:aws:ssm:sa-east-1:000000000000:parameter/PREENCHA-signing
CLOUDFRONT_KEY_ID=PREENCHA_KEY_ID

# Opcionais: defaults do runtime.
APP_ENV=production
MAX_UPLOAD_BYTES=21474836480

# Obrigatória somente para short; fonte: output short_link_parameter_arn.
SHORT_LINK_PARAMETER_ARN=arn:aws:ssm:sa-east-1:000000000000:parameter/PREENCHA/short-link-api-key
